<?xml version="1.0" encoding="utf-8"?>
<!-- Wersja F-Droid: bez samoaktualizacji, więc bez uprawnień do instalowania pakietów. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />

    <!-- Odbiorniki aktualizatora (stan instalacji, ponowne uruchomienie po aktualizacji) są tu zbędne. -->
    <application>
        <receiver android:name="com.blacksingularities.openexplorer.update.UpdateReceiver" tools:node="remove" />
        <receiver android:name="com.blacksingularities.openexplorer.update.PackageReplacedReceiver" tools:node="remove" />
    </application>
</manifest>
